# ==============================================================================
# SchoolFin Environment Variables Template
# All secrets live here. Never commit actual secret values.
# ==============================================================================

# Database (PostgreSQL - Supabase / Neon / Local)
DATABASE_URL="postgresql://user:password@localhost:5432/schoolfin?schema=public"

# Redis (Session Store, Rate Limiting, BullMQ)
REDIS_URL="redis://localhost:6379"

# NextAuth.js
NEXTAUTH_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Application-level PII & Card Token Encryption (AES-256-GCM: 32 bytes hex = 64 characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Flutterwave Payment Gateway (Phase 1+)
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_SECRET_HASH="your-webhook-secret-hash-here"

# Termii SMS Provider (Phase 1+)
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="SchoolFin"

# Resend Email Provider (Phase 0+)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="SchoolFin <billing@resend.dev>"
RESEND_DOMAIN="resend.dev"

# Proprietor Email (for sensitive audit notifications & alerts)
PROPRIETOR_EMAIL="proprietor@greenwoodacademy.ng"

# Node Environment
NODE_ENV="development"
